{"translation-revision-date":"2026-06-28 11:51:58+00:00","generator":"WP-CLI\/2.12.0","source":"assets\/js\/admin-common.js","domain":"messages","locale_data":{"messages":{"":{"domain":"messages","lang":"ko","plural-forms":"nplurals=1; plural=0;"},"2":["2"],"Import complete!":["\uac00\uc838\uc624\uae30\uac00 \uc644\ub8cc\ub410\uc5b4\uc694!"],"Show more details":["\uc790\uc138\ud788 \ubcf4\uae30"],"Actions":["\uc791\uc5c5"],"Expires":["\ub9cc\ub8cc\uc77c"],"Lift restriction":["\uc81c\ud55c \ud574\uc81c"],"Member":["\uba64\ubc84"],"Moderator":["\uc6b4\uc601\uc790"],"Admin":["\uad00\ub9ac\uc790"],"Viewer":["\uc5f4\ub78c\uc790"],"Invite Link":["\ucd08\ub300 \ub9c1\ud06c"],"Uses":["\uc0ac\uc6a9 \ud69f\uc218"],"Label":["\ub77c\ubca8"],"Delete permanently":["\uc601\uad6c \uc0ad\uc81c"],"Banned":["\ucc28\ub2e8\ub428"],"Silenced":["\ubc1c\uc5b8 \uc81c\ud55c\ub428"],"Ban":["\uc774\uc6a9 \uc815\uc9c0"],"Ban IP address":["IP \uc8fc\uc18c \uc774\uc6a9 \uc815\uc9c0"],"Never":["\uc811\uc18d \uae30\ub85d \uc5c6\uc74c"],"Ban User":["\uc0ac\uc6a9\uc790 \uc774\uc6a9 \uc815\uc9c0"],"Remove prefix":["\ub9d0\uba38\ub9ac \uc81c\uac70"],"Copy":["\ubcf5\uc0ac"],"Revoke":["\ucde8\uc18c"],"Are you sure? This cannot be undone.":["\uc815\ub9d0\ub85c \uc9c4\ud589\ud558\uc2dc\uaca0\uc5b4\uc694? \uc774 \uc791\uc5c5\uc740 \ucde8\uc18c\ud560 \uc218 \uc5c6\uc5b4\uc694."],"Lift this restriction? The %s can post again right away.":["\uc774 \uc81c\ud55c\uc744 \ud574\uc81c\ud560\uae4c\uc694? \ud574\uc81c\ud558\uba74 %s\uc758 \uae00\uc4f0\uae30\uac00 \ubc14\ub85c \ub2e4\uc2dc \ud5c8\uc6a9\ub3fc\uc694."],"Archive this %1$s and hand it to an administrator? Its %2$s and %3$s are kept and nothing is deleted. %4$s will no longer be able to post in it.":["\uc774 %1$s\uc744(\ub97c) \ubcf4\uad00\ud558\uace0 \uad00\ub9ac\uc790\uc5d0\uac8c \ub118\uae38\uae4c\uc694? \ud3ec\ud568\ub41c %2$s \ubc0f %3$s\uc740(\ub294) \uadf8\ub300\ub85c \uc720\uc9c0\ub418\uba70 \uc0ad\uc81c\ub418\uc9c0 \uc54a\uc544\uc694. \uc55e\uc73c\ub85c %4$s\uc740(\ub294) \uc5ec\uae30\uc5d0 \uae00\uc744 \uc791\uc131\ud560 \uc218 \uc5c6\uc5b4\uc694."],"Permanently delete this %1$s and EVERY %2$s, %3$s and attachment in it, including content written by other %4$s? This cannot be undone.":["\uc774 %1$s\uc744(\ub97c) \uc601\uad6c \uc0ad\uc81c\ud560\uae4c\uc694? \uc548\uc5d0 \uc788\ub294 \ubaa8\ub4e0 %2$s, %3$s, \ucca8\ubd80 \ud30c\uc77c\uc774 \ud568\uaed8 \uc0ad\uc81c\ub418\uba70, \ub2e4\ub978 %4$s\uc774(\uac00) \uc791\uc131\ud55c \ucf58\ud150\uce20\ub3c4 \ud3ec\ud568\ub3fc\uc694. \ub418\ub3cc\ub9b4 \uc218 \uc5c6\uc5b4\uc694."],"This destroys every %2$s, %3$s and attachment in %1$s, including content written by other %4$s. It cannot be undone. Type the %5$s name to confirm.":["%1$s \uc548\uc758 \ubaa8\ub4e0 %2$s, %3$s, \ucca8\ubd80 \ud30c\uc77c\uc774 \uc0ad\uc81c\ub418\uba70, \ub2e4\ub978 %4$s\uc774(\uac00) \uc791\uc131\ud55c \ucf58\ud150\uce20\ub3c4 \ud3ec\ud568\ub3fc\uc694. \ub418\ub3cc\ub9b4 \uc218 \uc5c6\uc5b4\uc694. \ud655\uc778\ud558\ub824\uba74 %5$s \uc774\ub984\uc744 \uc785\ub825\ud574 \uc8fc\uc138\uc694."],"Mark this as spam? It will be hidden from the community.":["\uc2a4\ud338\uc73c\ub85c \ud45c\uc2dc\ud560\uae4c\uc694? \ucee4\ubba4\ub2c8\ud2f0\uc5d0\uc11c \uc228\uaca8\uc838\uc694."],"Move this to trash? This removes it from the community.":["\ud734\uc9c0\ud1b5\uc73c\ub85c \uc774\ub3d9\ud560\uae4c\uc694? \ucee4\ubba4\ub2c8\ud2f0\uc5d0\uc11c \uc228\uaca8\uc838\uc694."],"Saving\u2026":["\uc800\uc7a5 \uc911\u2026"],"Saved!":["\uc800\uc7a5\ub410\uc5b4\uc694!"],"Something went wrong.":["\ubb38\uc81c\uac00 \ubc1c\uc0dd\ud588\uc5b4\uc694."],"Error: %s":["\uc624\ub958: %s"],"Unknown error":["\uc54c \uc218 \uc5c6\ub294 \uc624\ub958"],"Select Image":["\uc774\ubbf8\uc9c0 \uc120\ud0dd"],"Use this image":["\uc774 \uc774\ubbf8\uc9c0 \uc0ac\uc6a9"],"Hidden %s must use Invite Only. Join policy switched.":["\uc228\uae40 %s\uc740(\ub294) \ucd08\ub300 \uc804\uc6a9\ub9cc \uc0ac\uc6a9\ud560 \uc218 \uc788\uc5b4\uc694. \uac00\uc785 \uc815\ucc45\uc744 \ubcc0\uacbd\ud588\uc5b4\uc694."],"Switched visibility to Private because Hidden requires Invite Only.":["\uc228\uae40\uc740 \ucd08\ub300 \uc804\uc6a9\uc774 \ud544\uc694\ud558\ubbc0\ub85c \uacf5\uac1c \ubc94\uc704\ub97c \ube44\uacf5\uac1c\ub85c \ubcc0\uacbd\ud588\uc5b4\uc694."],"Private %s need approval or an invite. Join policy switched to Approval Required.":["\ube44\uacf5\uac1c %s\uc740(\ub294) \uc2b9\uc778 \ub610\ub294 \ucd08\ub300\uac00 \ud544\uc694\ud574\uc694. \uac00\uc785 \uc815\ucc45\uc744 \uc2b9\uc778 \ud544\uc694\ub85c \ubcc0\uacbd\ud588\uc5b4\uc694."],"Switched visibility to Public because anyone-can-join needs a public %s.":["\uacf5\uac1c \ubc94\uc704\ub97c \uacf5\uac1c\ub85c \ubcc0\uacbd\ud588\uc5b4\uc694. \ub204\uad6c\ub098 \uac00\uc785 \uac00\ub2a5 \uc124\uc815\uc5d0\ub294 \uacf5\uac1c\ub41c %s\uc774(\uac00) \ud544\uc694\ud574\uc694."],"Reload page":["\ud398\uc774\uc9c0 \uc0c8\ub85c\uace0\uce68"],"Connection lost. You can resume this import later.":["\uc5f0\uacb0\uc774 \ub04a\uacbc\uc5b4\uc694. \uc774 \uac00\uc838\uc624\uae30\ub294 \ub098\uc911\uc5d0 \ub2e4\uc2dc \uc2dc\uc791\ud560 \uc218 \uc788\uc5b4\uc694."],"Invite link copied to clipboard.":["\ucd08\ub300 \ub9c1\ud06c\uac00 \ud074\ub9bd\ubcf4\ub4dc\uc5d0 \ubcf5\uc0ac\ub410\uc5b4\uc694."],"Revoke this invite link? Anyone holding it will no longer be able to join.":["\uc774 \ucd08\ub300 \ub9c1\ud06c\ub97c \ud574\uc81c\ud560\uae4c\uc694? \ub9c1\ud06c\ub97c \uac00\uc9c4 \uc0ac\ub78c\uc740 \ub354 \uc774\uc0c1 \uac00\uc785\ud560 \uc218 \uc5c6\uac8c \ub3fc\uc694."],"Unlimited":["\ubb34\uc81c\ud55c"],"Expired":["\ub9cc\ub8cc\ub428"],"Load more":["\ub354 \ubcf4\uae30"],"Sync":["\ub3d9\uae30\ud654"],"Syncing\u2026":["\ub3d9\uae30\ud654 \uc911\u2026"],"Synced (%d)":["\ub3d9\uae30\ud654\ub428(%d)"],"This will discard the interrupted import progress. Continue?":["\uc911\ub2e8\ub41c \uac00\uc838\uc624\uae30 \uc9c4\ud589 \uc0c1\ud669\uc774 \uc0ad\uc81c\ub3fc\uc694. \uacc4\uc18d\ud560\uae4c\uc694?"],"Restart import":["\uac00\uc838\uc624\uae30 \ub2e4\uc2dc \uc2dc\uc791"],"People who match this rule":["\uc774 \uaddc\uce59\uc5d0 \ud574\ub2f9\ud558\ub294 \uc0ac\ub78c"],"Choose who this rule lets in. Nothing changes until you add the rule.":["\uc774 \uaddc\uce59\uc73c\ub85c \ub204\uad6c\ub97c \ub4e4\uc5ec\ubcf4\ub0bc\uc9c0 \uc120\ud0dd\ud558\uc138\uc694. \uaddc\uce59\uc744 \ucd94\uac00\ud558\uae30 \uc804\uc5d0\ub294 \uc544\ubb34\uac83\ub3c4 \ubc14\ub00c\uc9c0 \uc54a\uc544\uc694."],"%1$s will be let in to this private %2$s and can take part right away. Continue?":["\uc774 \ube44\uacf5\uac1c \ud56d\ubaa9\uc5d0\ub294 %1$s \ub300\uc0c1\uc774 \ubc14\ub85c \ub4e4\uc5b4\uc640 \ucc38\uc5ec\ud560 \uc218 \uc788\uc5b4\uc694. \uacc4\uc18d\ud560\uae4c\uc694? (\ud56d\ubaa9: %2$s)"],"Add rule":["\uaddc\uce59 \ucd94\uac00"],"Rule added: %s":["\uaddc\uce59\uc744 \ucd94\uac00\ud588\uc5b4\uc694: %s"],"%1$s can %2$s. They are recorded as %3$s.":["\ub300\uc0c1: %1$s \/ \ud5c8\uc6a9 \ubc94\uc704: %2$s \/ \uae30\ub85d\ub418\ub294 \uc5ed\ud560: %3$s"],"read and report posts and %s":["\uac8c\uc2dc\ubb3c \uc77d\uae30, \uc2e0\uace0, %s \uc791\uc131"],"read, post, reply, vote and report":["\uc77d\uae30, \uac8c\uc2dc, \ub2f5\uae00 \uc791\uc131, \ud22c\ud45c, \uc2e0\uace0"],"read, post, reply, vote, report, and - if their WordPress role already allows moderation - edit, close or pin other people's %s":["\uc77d\uae30, \uac8c\uc2dc, \ub2f5\uae00 \uc791\uc131, \ud22c\ud45c, \uc2e0\uace0, \uadf8\ub9ac\uace0 WordPress \uc5ed\ud560\uc5d0\uc11c \uc774\ubbf8 \uad00\ub9ac\uac00 \ud5c8\uc6a9\ub41c \uacbd\uc6b0 \ub2e4\ub978 \uc0ac\ub78c\uc758 %s \uc218\uc815, \ub2eb\uae30, \uace0\uc815"],"Matches everyone. A visitor who is not signed in is still asked to log in first, so on a Private %s this works like Logged In.":["\ubaa8\ub4e0 \uc0ac\ub78c\uc5d0\uac8c \uc801\uc6a9\ub3fc\uc694. \ub85c\uadf8\uc778\ud558\uc9c0 \uc54a\uc740 \ubc29\ubb38\uc790\ub294 \uba3c\uc800 \ub85c\uadf8\uc778\ud574\uc57c \ud558\ubbc0\ub85c, \ube44\uacf5\uac1c %s\uc5d0\uc11c\ub294 '\ub85c\uadf8\uc778\ud55c \uc0ac\uc6a9\uc790' \uaddc\uce59\uacfc \ub611\uac19\uc774 \uc791\ub3d9\ud574\uc694."],"Matches anyone with an account on this site, whoever they are. A new registration matches the moment it is created.":["\uc774 \uc0ac\uc774\ud2b8\uc5d0 \uacc4\uc815\uc774 \uc788\ub294 \uc0ac\ub78c\uc774\ub77c\uba74 \ub204\uad6c\uc5d0\uac8c\ub098 \uc801\uc6a9\ub3fc\uc694. \uc0c8\ub85c \uac00\uc785\ud55c \uacc4\uc815\uc740 \ub9cc\ub4e4\uc5b4\uc9c0\ub294 \uc989\uc2dc \ud574\ub2f9\ub3fc\uc694."],"Matches anyone holding this WordPress role. Most %s hold Subscriber, the role WordPress gives new registrations, so a Subscriber rule usually means \"everyone who signed up\".":["\uc774 WordPress \uc5ed\ud560\uc744 \uac00\uc9c4 \uc0ac\ub78c\uc5d0\uac8c \uc801\uc6a9\ub3fc\uc694. WordPress\ub294 \uc0c8 \uac00\uc785\uc790\uc5d0\uac8c \uad6c\ub3c5\uc790 \uc5ed\ud560\uc744 \ubd80\uc5ec\ud558\ubbc0\ub85c, \ub300\ubd80\ubd84\uc758 %s\uc774 \uad6c\ub3c5\uc790 \uc5ed\ud560\uc744 \uac00\uc838\uc694. \ub530\ub77c\uc11c \uad6c\ub3c5\uc790 \uaddc\uce59\uc740 \ubcf4\ud1b5 \"\uac00\uc785\ud55c \ubaa8\ub4e0 \uc0ac\ub78c\"\uc744 \ub73b\ud574\uc694."],"Matches anyone whose WordPress role carries this capability. Use it when several roles should match one rule, or when another plugin grants the capability on the fly.":["WordPress \uc5ed\ud560\uc5d0 \uc774 \uad8c\ud55c\uc774 \uc788\ub294 \uc0ac\ub78c\uc5d0\uac8c \uc801\uc6a9\ub3fc\uc694. \uc5ec\ub7ec \uc5ed\ud560\uc744 \ud558\ub098\uc758 \uaddc\uce59\uc73c\ub85c \ubb36\uac70\ub098, \ub2e4\ub978 \ud50c\ub7ec\uadf8\uc778\uc774 \uad8c\ud55c\uc744 \uc989\uc11d\uc5d0\uc11c \ubd80\uc5ec\ud560 \ub54c \uc0ac\uc6a9\ud558\uc138\uc694."],"Matches %s at or above this trust level, 1 to 5. Trust is earned by taking part, so this rule lets more people in over time without you touching it.":["\uc2e0\ub8b0 \ub808\ubca8 1~5 \uc911 \uc774 \ub808\ubca8 \uc774\uc0c1\uc778 %s\uc5d0\uac8c \uc801\uc6a9\ub3fc\uc694. \uc2e0\ub8b0 \ub808\ubca8\uc740 \ucc38\uc5ec\ud558\uba74\uc11c \uc313\uc774\ubbc0\ub85c, \uc774 \uaddc\uce59\uc740 \ub530\ub85c \uc190\ub300\uc9c0 \uc54a\uc544\ub3c4 \uc2dc\uac04\uc774 \uc9c0\ub0a0\uc218\ub85d \ub354 \ub9ce\uc740 \uc0ac\ub78c\uc744 \ubc1b\uc544\ub4e4\uc5ec\uc694."],"Matches %2$s who hold the %1$s level you pick below.":["\uc544\ub798\uc5d0\uc11c \uace0\ub978 %1$s \ub808\ubca8\uc744 \uac00\uc9c4 \ub300\uc0c1\uc5d0\uac8c \uc801\uc6a9\ub3fc\uc694 (\ub300\uc0c1: %2$s)."],"subscriber":["\uad6c\ub3c5\uc790"],"edit_posts":["edit_posts"],"No matches":["\uc77c\uce58 \ud56d\ubaa9 \uc5c6\uc74c"],"%d more. Refine your search to see it.":["%d\uac1c \ub354 \uc788\uc5b4\uc694. \uac80\uc0c9\uc5b4\ub97c \uc881\ud600\uc11c \ud655\uc778\ud558\uc138\uc694."],"Showing %1$s of %2$s invite links.":["\ucd08\ub300 \ub9c1\ud06c %2$s\uac1c \uc911 %1$s\uac1c\ub97c \ud45c\uc2dc\ud558\uace0 \uc788\uc5b4\uc694."],"Silence User":["\uc0ac\uc6a9\uc790 \ubc1c\uc5b8 \uc81c\ud55c"],"Banning: %s":["\ucc28\ub2e8 \uc911: %s"],"Silencing: %s":["\ubc1c\uc5b8 \uc81c\ud55c \uc911: %s"],"Banning an IP address used by: %s":["IP \uc8fc\uc18c \ucc28\ub2e8 \uc911, \uc0ac\uc6a9 \uc911\uc778 \uc0ac\uc6a9\uc790: %s"],"%d record imported successfully.":["\ub808\ucf54\ub4dc %d\uac1c\ub97c \uac00\uc838\uc654\uc5b4\uc694."],"%d file could not be recovered and was left linked in the original post text.":["\ud30c\uc77c %d\uac1c\ub97c \ubcf5\uad6c\ud558\uc9c0 \ubabb\ud574 \uc6d0\ub798 \uac8c\uc2dc\ubb3c \ubcf8\ubb38\uc5d0 \ub9c1\ud06c\ub41c \ucc44\ub85c \ub450\uc5c8\uc5b4\uc694."],"%s to see updated status.":["\uc5c5\ub370\uc774\ud2b8\ub41c \uc0c1\ud0dc\ub97c \ubcf4\ub824\uba74 %s\ud558\uc138\uc694."]}}}