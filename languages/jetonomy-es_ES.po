msgstr "Mapa del sitio XML"

#: includes/admin/views/settings.php:1215
msgid "Include community pages in the WordPress XML sitemap"
msgstr "Incluir las páginas de la comunidad en el mapa del sitio XML de WordPress"

#: includes/admin/views/settings.php:1220
msgid "Noindex"
msgstr "Noindex"

#: includes/admin/views/settings.php:1225
