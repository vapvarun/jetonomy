msgstr "Карточки и области контента."

#: includes/admin/views/settings.php:1143
msgid "Subtle Background"
msgstr "Приглушённый фон"

#: includes/admin/views/settings.php:1146
msgid "Secondary surfaces: table headers, code, quiet panels."
msgstr "Вторичные области: заголовки таблиц, код, неброские панели."

#: includes/admin/views/settings.php:1150
msgid "Border"
msgstr "Граница"

#: includes/admin/views/settings.php:1153
