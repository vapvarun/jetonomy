#: includes/admin/views/settings.php:1161
#: includes/admin/views/settings.php:1567
msgid "White Label"
msgstr "Собственный брендинг"

#: includes/admin/views/settings.php:1162
msgid ""
"Replace Jetonomy branding with your own community name, footer text, and "
"wp-admin menu label and icon."
msgstr ""
"Замените брендинг Jetonomy на собственное название сообщества, текст в "
"подвале, а также название и значок пункта меню в wp-admin."

#: includes/admin/views/settings.php:1172
msgid "Title Templates"
msgstr "Шаблоны заголовков"

#: includes/admin/views/settings.php:1173
msgid "Control how page titles are formatted for community pages."
msgstr "Настройте формат заголовков страниц сообщества."

#: includes/admin/views/settings.php:1177
