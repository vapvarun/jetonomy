msgstr "Применяется только к страницам сообщества (%s, обсуждения, профиль и т. д.)."

#: includes/admin/views/settings.php:1110
msgid "Page Padding"
msgstr "Отступы страницы"

#: includes/admin/views/settings.php:1120
